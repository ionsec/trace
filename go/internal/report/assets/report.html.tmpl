        <tr><td>Size</td><td>{{.SizeText}}</td></tr>
        <tr><td>Collected At</td><td>{{.CollectedAt}}</td></tr>
        <tr><td>Collector Version</td><td>{{.CollectorVersion}}</td></tr>
