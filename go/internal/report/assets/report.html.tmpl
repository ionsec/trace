<!-- ===== Branding ===== -->
<header class="brand">
  <div class="brand-top">
    <a class="brand-org" href="https://ionsec.io/" target="_blank" rel="noopener">
      <svg class="ionsec-logo" viewBox="0 0 160 25" width="112" height="17" role="img" aria-label="IONSEC"><use href="#ionsec-wordmark"></use></svg>
      <span class="brand-org-note">an IONSEC product</span>
    </a>
    <a class="brand-id" href="https://github.com/ionsec/trace" target="_blank" rel="noopener">github.com/ionsec/trace</a>
  </div>
  <h1><span class="brand-word">TRACE</span> <span class="brand-sub">&mdash; Forensic Report</span></h1>
  <div class="brand-meta">
    <span><span class="mk">Report</span> <code>{{.ReportID}}</code></span>
    <span><span class="mk">Generated</span> {{.GeneratedAt}}</span>
    <span><span class="mk">Tool</span> TRACE v{{.Version}}</span>
    {{if .SourceOS}}<span><span class="mk">Source OS</span> {{.SourceOS}}</span>{{end}}
    {{if .Hostname}}<span><span class="mk">Host</span> <code>{{.Hostname}}</code></span>{{end}}
    <span><span class="mk">Evidence dir</span> <code class="path">{{.EvidenceDir}}</code></span>
  </div>
</header>

<!-- ===== Stat Strip ===== -->
<div class="stats">
  <div class="stat"><div class="stat-label">Risk Score</div><div class="stat-value" style="color:{{.RiskColor}}">{{.RiskScore}}<span class="unit">/100</span></div><div class="stat-sub">{{.RiskSeverity}}</div></div>
  <div class="stat"><div class="stat-label">Files Collected</div><div class="stat-value">{{.TotalArtifacts}}</div><div class="stat-sub">evidence artifacts</div></div>
  <div class="stat"><div class="stat-label">IOCs</div><div class="stat-value">{{.TotalIOCs}}</div><div class="stat-sub">indicators of compromise</div></div>
  <div class="stat"><div class="stat-label">Platforms</div><div class="stat-value">{{.PlatformCount}}</div><div class="stat-sub">{{.PlatformList}}</div></div>
  <div class="stat"><div class="stat-label">Findings</div><div class="stat-value">{{.TotalFindings}}</div><div class="stat-sub">{{.CriticalCount}} critical &middot; {{.HighCount}} high</div></div>
  <div class="stat"><div class="stat-label">Kill Chain</div><div class="stat-value{{if ge .KillChainDetected 3}} danger{{end}}">{{.KillChainDetected}}<span class="unit">/{{.KillChainTotal}}</span></div><div class="stat-sub">stages detected</div></div>
</div>

<!-- ===== Tabs ===== -->
<nav class="tabs" id="tabs">
  <button class="tab-btn active" data-tab="overview">Overview</button>
  <button class="tab-btn" data-tab="map">Attack Map</button>
  <button class="tab-btn" data-tab="findings">Findings</button>
  <button class="tab-btn" data-tab="iocs">IOCs</button>
  <button class="tab-btn" data-tab="timeline">Timeline</button>
  <button class="tab-btn" data-tab="mitre">MITRE</button>
  <button class="tab-btn" data-tab="killchain">Kill Chain</button>
  <button class="tab-btn" data-tab="actions">Actions</button>
  <button class="tab-btn" data-tab="narratives">Narratives</button>
  <button class="tab-btn" data-tab="correlation">Correlation</button>
  <button class="tab-btn" data-tab="conversation">Conversation</button>
  <button class="tab-btn" data-tab="secrethunt">Secret Hunt</button>
  <button class="tab-btn" data-tab="risk">Risk</button>
  <button class="tab-btn" data-tab="evidence">Evidence</button>
  <button class="tab-btn" data-tab="appendix">Appendix</button>
</nav>

<!-- ===== OVERVIEW ===== -->
<section class="tab-panel active" id="panel-overview">
  <h2>Executive Summary</h2>
  <div class="card"><div class="card-body">
    <p>{{.SummaryText}}</p>
    <p><strong>{{.RiskScore}}/100</strong> &mdash; {{.RiskInterpretation}}</p>
    <div class="risk-meter"><div class="risk-fill" style="width:{{.RiskScore}}%;background:{{.RiskColor}}"></div></div>
    <div class="badges">
      {{range .Platforms}}<span class="badge">{{.}}</span>{{end}}
      {{range .SeverityBadges}}<span class="badge sev-{{.Key}}">{{.Label}}: {{.Value}}</span>{{end}}
    </div>
  </div></div>

  <h2>Charts &amp; Stats</h2>
  <div class="charts">
    <div class="chart-card">
      <h4>Risk Score Gauge</h4>
      <div class="radial gauge">
        {{.GaugeSVG}}
        <div class="radial-hole"><div class="radial-num">{{.RiskScore}}</div><div class="radial-sub">/ 100</div></div>
      </div>
      <div class="chart-legend"><span class="lg"><span class="sw" style="background:var(--danger)"></span>Critical</span><span class="lg"><span class="sw" style="background:var(--high)"></span>High</span><span class="lg"><span class="sw" style="background:var(--warning)"></span>Medium</span><span class="lg"><span class="sw" style="background:var(--info)"></span>Low</span></div>
    </div>
    <div class="chart-card">
      <h4>Findings by Severity</h4>
      {{if .TotalFindings}}<div class="hbars">{{range .SeverityBars}}
        <div class="hbar"><div class="hbar-track"><div class="hbar-fill" style="width:{{.Pct}};background:{{.Color}}"></div><span class="hbar-name">{{.Label}}</span></div><span class="hbar-val">{{.Value}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No findings</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>Severity Distribution</h4>
      {{if .DonutSVG}}
      <div class="radial donut">
        {{.DonutSVG}}
        <div class="radial-hole"><div class="radial-num">{{.TotalFindings}}</div></div>
      </div>
      {{else}}<p class="chart-empty">No findings</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>IOCs by Type</h4>
      {{if .IOCBars}}<div class="hbars">{{range .IOCBars}}
        <div class="hbar"><div class="hbar-track"><div class="hbar-fill" style="width:{{.Pct}};background:{{.Color}}"></div><span class="hbar-name">{{.Label}}</span></div><span class="hbar-val" style="min-width:44px">{{.Value}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No IOCs</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>Platform Inventory</h4>
      {{if .PlatformBars}}<div class="hbars">{{range .PlatformBars}}
        <div class="hbar"><div class="hbar-track"><div class="hbar-fill" style="width:{{.Pct}};background:{{.Color}}"></div><span class="hbar-name">{{.Label}}</span></div><span class="hbar-val">{{.Value}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No platforms detected</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>Timeline Activity</h4>
      {{if .TimelineBars}}<div class="vbars">{{range .TimelineBars}}
        <div class="vbar" title="{{.Label}}: {{.Value}} events"><div class="vbar-fill" style="height:{{.Pct}}"></div><span class="vbar-label">{{.Label}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No timeline events</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>MITRE ATT&amp;CK Techniques</h4>
      {{if .MitreBars}}<div class="hbars">{{range .MitreBars}}
        <div class="hbar"><div class="hbar-track"><div class="hbar-fill" style="width:{{.Pct}};background:{{.Color}}"></div><span class="hbar-name">{{.Label}}</span></div><span class="hbar-val">{{.Value}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No MITRE mappings</p>{{end}}
    </div>
    <div class="chart-card">
      <h4>Enhanced Risk Categories</h4>
      {{if .RiskCatBars}}<div class="hbars">{{range .RiskCatBars}}
        <div class="hbar"><div class="hbar-track"><div class="hbar-fill" style="width:{{.Pct}};background:{{.Color}}"></div><span class="hbar-name">{{.Label}}</span></div><span class="hbar-val">{{.Value}}</span></div>{{end}}
      </div>{{else}}<p class="chart-empty">No enhanced risk data</p>{{end}}
    </div>
  </div>

  <h2>Top Priority Actions</h2>
  {{if .TopActions}}{{range $i, $a := .TopActions}}
  <div class="priority-action urgency-{{$a.Urgency}}">
    <span class="action-number">#{{inc $i}}</span>
    <span class="action-urgency" style="color:{{$a.Color}}">[{{$a.Urgency}}]</span>
    <div class="action-text">{{$a.Action}}</div>
  </div>
  {{end}}{{else}}<p style="color:var(--text-dim)">No priority actions identified.</p>{{end}}
</section>

<!-- ===== ATTACK MAP ===== -->
<section class="tab-panel" id="panel-map">
  <h2>Attack Surface Map</h2>
  <p style="color:var(--text-dim);font-size:.85rem">Interactive map of detected AI platforms. Node color reflects the highest-severity finding on that platform; connecting lines show cross-platform correlations. Click a node to inspect it.</p>
  <div class="map-wrap">
    <h3>Platform Correlation Map</h3>
    <div class="map-legend">
      <span class="lg"><span class="dot" style="background:var(--danger)"></span>Critical</span>
      <span class="lg"><span class="dot" style="background:var(--high)"></span>High</span>
      <span class="lg"><span class="dot" style="background:var(--warning)"></span>Medium</span>
      <span class="lg"><span class="dot" style="background:var(--info)"></span>Low</span>
      <span class="lg"><span class="dot" style="background:#888"></span>Info</span>
      <span class="lg"><span style="color:var(--accent)">- - -</span> Correlation</span>
    </div>
    <svg id="attackMap" viewBox="0 0 800 420" role="img" aria-label="Attack surface map"></svg>
    <div class="map-detail" id="mapDetail">
      <div class="md-title" id="mdTitle">Select a platform node</div>
      <div class="md-grid" id="mdGrid"></div>
    </div>
  </div>
</section>

<!-- ===== FINDINGS ===== -->
<section class="tab-panel" id="panel-findings">
  <h2>Findings</h2>
  <div class="filter-bar">
    <input type="text" id="findingsSearch" class="filter-input" placeholder="Filter findings…" oninput="filterFindings(this.value)">
    <select id="findingsSeverity" class="filter-select" onchange="filterFindings(document.getElementById('findingsSearch').value)">
      <option value="">All severities</option>
      <option value="critical">Critical</option>
      <option value="high">High</option>
      <option value="medium">Medium</option>
      <option value="low">Low</option>
      <option value="info">Info</option>
    </select>
  </div>
  {{if .Findings}}
  <div id="findingsList">
  {{range .Findings}}
  <div class="card finding-card" data-severity="{{.Severity}}" data-text="{{.SearchText}}">
    <div class="card-header" onclick="toggleCard(this)">
      <span><span class="sev-{{.Severity}}">{{.SeverityLabel}}</span> &mdash; {{.Title}}</span>
      <span class="toggle">[+]</span>
    </div>
    <div class="card-body collapsed">
      <p>{{.Description}}</p>
      {{if .Evidence}}<h4>Evidence</h4><ul>{{range .Evidence}}<li><code>{{.}}</code></li>{{end}}</ul>{{end}}
      {{if .Locations}}<h4>Locations{{if gt .Occurrences 1}} &mdash; {{.Occurrences}} match(es){{end}}</h4>
      <ul>{{range .Locations}}<li><code>{{.File}}{{if .Line}}:{{.Line}}{{end}}</code>{{if .Turn}} <span style="color:var(--text-dim)">turn {{.Turn}}</span>{{end}}{{if .Match}} &mdash; <code>{{.Match}}</code>{{end}}</li>{{end}}</ul>
      {{if .LocationsTruncated}}<p style="font-size:.78rem;color:var(--text-dim)">Location list truncated; {{.Occurrences}} match(es) in total.</p>{{end}}{{end}}
      {{if .MITREAtlas}}<h4>MITRE ATLAS</h4><ul>{{range .MITREAtlas}}<li>{{.}}</li>{{end}}</ul>{{end}}
      {{if .Recommendation}}<h4>Recommendation</h4><p>{{.Recommendation}}</p>{{end}}
      <p style="font-size:.75rem;color:var(--text-dim)">ID: {{.ID}} &middot; Platform: {{.Platform}} &middot; Risk: {{.RiskScore}}</p>
    </div>
  </div>
  {{end}}
  </div>
  <p id="findingsEmpty" style="color:var(--text-dim);display:none">No findings match the current filter.</p>
  {{else}}<p style="color:var(--text-dim)">No findings recorded.</p>{{end}}
</section>

<!-- ===== IOCS ===== -->
<section class="tab-panel" id="panel-iocs">
  <h2>IOC Extractor Results</h2>
  {{if .IOCs}}
  <div class="card"><div class="card-body">
    <p><strong>{{.TotalIOCs}}</strong> indicators of compromise extracted.</p>
    <table>
      <tr><th>Type</th><th class="n">Count</th></tr>
      {{range .IOCSummary}}<tr><td><span class="ioc-type">{{.Type}}</span></td><td class="n">{{.Count}}</td></tr>{{end}}
    </table>
  </div></div>
  <details>
  <summary>Show top {{len .IOCs}} IOCs (of {{.TotalIOCs}} — full list in report.json)</summary>
  <div class="card"><div class="card-body">
    <table class="sortable" id="iocTable">
      <tr><th data-sort="ioc_type">Type</th><th data-sort="value">Value</th><th data-sort="source">Source</th><th data-sort="severity">Severity</th></tr>
      {{range .IOCs}}<tr><td><span class="ioc-type">{{.IOCType}}</span></td><td><code>{{.Value}}</code></td><td>{{.SourceFile}}</td><td><span class="sev-{{.Severity}}">{{.Severity}}</span></td></tr>{{end}}
    </table>
  </div></div>
  </details>
  {{else}}<p style="color:var(--text-dim)">No IOCs extracted.</p>{{end}}
</section>

<!-- ===== TIMELINE ===== -->
<section class="tab-panel" id="panel-timeline">
  <h2>Event Timeline</h2>
  {{if .Timeline}}
  <div class="timeline">
    {{range .Timeline}}
    <div class="timeline-item"{{if .IsCollectionEvent}} style="opacity:0.55;font-style:italic"{{end}}>
      <div class="timeline-ts">{{.Timestamp}}</div>
      <div class="timeline-body">
        <strong>{{.Platform}}</strong> &mdash; {{.Description}}
        {{if .Severity}}<span class="sev-{{.Severity}}"> [{{.Severity}}]</span>{{end}}
        {{if .ContentPreview}}<br><small style="color:var(--text-dim)">{{.ContentPreview}}</small>{{end}}
      </div>
    </div>
    {{end}}
  </div>
  {{if .TimelineTruncated}}<p style="color:var(--text-dim);text-align:center;margin-top:1rem">Showing {{len .Timeline}} of {{.TimelineTotal}} events. See <code>report.json</code> for the full timeline.</p>{{end}}
  {{else}}<p style="color:var(--text-dim)">No timeline events recorded.</p>{{end}}
</section>

<!-- ===== MITRE ===== -->
<section class="tab-panel" id="panel-mitre">
  <h2>MITRE ATLAS Mapping</h2>
  {{if .AtlasSummary}}
  <div class="card"><div class="card-body">
    <p><strong>{{.AtlasTotal}}</strong> ATLAS technique mappings.</p>
    <table>
      <tr><th>Technique ID</th><th>Technique Name</th><th class="n">Count</th></tr>
      {{range .AtlasSummary}}<tr><td><code>{{.TechniqueID}}</code></td><td>{{.TechniqueName}}</td><td class="n">{{.Count}}</td></tr>{{end}}
    </table>
  </div></div>
  {{else}}<p style="color:var(--text-dim)">No MITRE ATLAS mappings available.</p>{{end}}

  <h2 style="margin-top:2rem">MITRE ATT&amp;CK Mapping</h2>
  {{if .MitreAttack}}
  <div class="card"><div class="card-body">
    <p><strong>{{len .MitreAttack}}</strong> ATT&amp;CK technique mappings derived from evidence.</p>
    <table>
      <tr><th>Technique ID</th><th>Name</th><th>Tactic</th><th class="n">Count</th><th>Evidence</th></tr>
      {{range .MitreAttack}}<tr><td><code>{{.TechniqueID}}</code></td><td>{{.TechniqueName}}</td><td>{{.Tactic}}</td><td class="n">{{.Count}}</td><td style="font-size:.78rem">{{.EvidenceText}}</td></tr>{{end}}
    </table>
  </div></div>
  {{else}}<p style="color:var(--text-dim)">No MITRE ATT&amp;CK mappings derived from available evidence.</p>{{end}}
</section>

<!-- ===== KILL CHAIN ===== -->
<section class="tab-panel" id="panel-killchain">
  <h2>Kill Chain Analysis</h2>
  {{if .KillChain}}
  <div style="margin:1rem 0">
    <div class="kill-chain-bar">
      {{range .KillChain}}
      <div class="kill-chain-stage {{if .Detected}}detected{{end}} {{.StageID}}" title="{{.Stage}}{{if .Detected}}: Detected{{else}}: Not detected{{end}}">
        {{.Short}}<br>{{if .Detected}}detected{{else}}&mdash;{{end}}
      </div>
      {{end}}
    </div>
    <p style="font-size:.8rem;color:var(--text-dim);margin-top:.3rem">{{.KillChainDetected}} of {{.KillChainTotal}} stages detected</p>
  </div>
  <div class="card"><div class="card-body">
    <table>
      <tr><th>Stage</th><th>Status</th><th>Evidence</th></tr>
      {{range .KillChain}}
      <tr><td><strong>{{.Stage}}</strong></td><td>{{if .Detected}}<span style="color:var(--danger)">Detected</span>{{else}}<span style="color:var(--text-dim)">— Not detected</span>{{end}}</td><td>{{.EvidenceText}}</td></tr>
      {{end}}
    </table>
  </div></div>
  {{else}}<p style="color:var(--text-dim)">No kill chain data available.</p>{{end}}
</section>

<!-- ===== ACTIONS ===== -->
<section class="tab-panel" id="panel-actions">
  <h2>Priority Actions</h2>
  {{if .Actions}}{{range $i, $a := .Actions}}
  <div class="priority-action urgency-{{$a.Urgency}}">
    <span class="action-number">#{{inc $i}}</span>
    <span class="action-urgency" style="color:{{$a.Color}}">[{{$a.Urgency}}]</span>
    <div class="action-text">{{$a.Action}}</div>
    {{if $a.Evidence}}<div style="font-size:.8rem;color:var(--text-dim);margin-top:.3rem">Evidence: {{range $a.Evidence}}<code>{{.}}</code> {{end}}</div>{{end}}
  </div>
  {{end}}{{else}}<p style="color:var(--text-dim)">No priority actions identified.</p>{{end}}
</section>

<!-- ===== NARRATIVES ===== -->
<section class="tab-panel" id="panel-narratives">
  <h2>Attack Narratives</h2>
  {{if .Narratives}}{{range .Narratives}}
  <div class="narrative-card">
    <h4><span class="sev-{{.Severity}}">{{.SeverityLabel}}</span> &mdash; {{.Title}}</h4>
    <div class="narrative-meta">
      <span class="badge">Confidence: {{.Confidence}}</span>
      {{range .KillChainStages}}<span class="badge sev-high">{{.}}</span>{{end}}
    </div>
    <p style="margin:.5rem 0"><strong>Affected platforms:</strong> {{.PlatformText}}</p>
    <p style="font-size:.85rem">{{.Recommendation}}</p>
    {{if .EvidenceRefs}}<p style="font-size:.8rem;color:var(--text-dim)">Evidence: {{range .EvidenceRefs}}<code>{{.}}</code> {{end}}</p>{{end}}
    {{if .IOCRefs}}<p style="font-size:.8rem;color:var(--text-dim)">IOCs: {{range .IOCRefs}}<code>{{.}}</code> {{end}}</p>{{end}}
  </div>
  {{end}}{{else}}<p style="color:var(--text-dim)">No attack narratives identified.</p>{{end}}
</section>

<!-- ===== CORRELATION ===== -->
<section class="tab-panel" id="panel-correlation">
  <h2>Cross-Platform Correlation</h2>
  {{if .Correlations}}
  <div class="card"><div class="card-body">
    <p><strong>{{len .Correlations}}</strong> cross-platform correlation(s) detected.</p>
    <table>
      <tr><th>Indicator</th><th>Type</th><th>Platforms</th><th>Severity</th></tr>
      {{range .Correlations}}
      <tr><td><code>{{.Indicator}}</code></td><td>{{.CorrelationType}}</td><td>{{range .Platforms}}<span class="corr-badge">{{.}}</span>{{end}}</td><td><span class="sev-{{.Severity}}">{{.Severity}}</span></td></tr>
      {{end}}
    </table>
  </div></div>
  {{else}}<p style="color:var(--text-dim)">No cross-platform correlations detected.</p>{{end}}
</section>

<!-- ===== CONVERSATION ===== -->
<section class="tab-panel" id="panel-conversation">
  <h2>Conversation Forensics</h2>
  {{if .Conversation.TotalSessions}}
  <div class="card"><div class="card-body">
    <p><strong>{{.Conversation.TotalSessions}}</strong> conversation session(s) analyzed. <strong>{{.Conversation.JailbreakAttemptsTotal}}</strong> jailbreak attempt(s) detected. <strong>{{.Conversation.ToolCallsTotal}}</strong> tool call(s) recorded.</p>
